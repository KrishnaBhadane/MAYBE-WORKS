# ==========================================
# kreepycode — Environment Variables
# ==========================================

# 1. Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET_KEY=create-a-random-secure-secret-for-admin-bootstrap

# 3. Code Runner (OnlineCompiler.io Piston Drop-In: 100k free runs/mo, or Self-Hosted Piston)
CODE_RUNNER_API_URL=https://api.onlinecompiler.io/api/run-code-sync/
CODE_RUNNER_API_KEY=
